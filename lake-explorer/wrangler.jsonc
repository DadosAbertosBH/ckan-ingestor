{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noctcloud-lake-explorer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/engine/*.wasm"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "public-datasets" }],
  "ratelimits": [{ "name": "SESSION_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }],
  "vars": {
    "R2_ACCOUNT_ID": "d8915a6c9b1e24b2ded7d9cd72318cdd",
    "R2_ENDPOINT": "https://d8915a6c9b1e24b2ded7d9cd72318cdd.r2.cloudflarestorage.com",
    "BUCKET_NAME": "public-datasets"
  },
  "secrets": { "required": ["R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY"] }
}
