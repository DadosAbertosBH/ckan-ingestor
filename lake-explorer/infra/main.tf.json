{
  "terraform": {
    "required_version": ">= 1.5",
    "required_providers": { "cloudflare": { "source": "cloudflare/cloudflare", "version": "~> 5.0" } }
  },
  "provider": { "cloudflare": {} },
  "variable": {
    "account_id": { "type": "string", "default": "d8915a6c9b1e24b2ded7d9cd72318cdd" },
    "bucket_name": { "type": "string", "default": "public-datasets" },
    "portal_origin": {
      "type": "string",
      "description": "HTTPS origin of the deployed portal, without trailing slash",
      "validation": { "condition": "${can(regex(\"^https://[^/]+$\", var.portal_origin))}", "error_message": "Provide a single HTTPS origin." }
    },
    "public_domains": {
      "type": "map(string)",
      "default": {},
      "description": "Existing R2 custom domains discovered during audit: domain => zone ID. Every listed domain is disabled."
    }
  },
  "resource": {
    "cloudflare_r2_managed_domain": {
      "lake": { "account_id": "${var.account_id}", "bucket_name": "${var.bucket_name}", "enabled": false }
    },
    "cloudflare_r2_custom_domain": {
      "existing": {
        "for_each": "${var.public_domains}", "account_id": "${var.account_id}", "bucket_name": "${var.bucket_name}",
        "domain": "${each.key}", "zone_id": "${each.value}", "enabled": false
      }
    },
    "cloudflare_r2_bucket_cors": {
      "explorer": {
        "account_id": "${var.account_id}", "bucket_name": "${var.bucket_name}",
        "rules": [{
          "id": "lake-explorer-read",
          "allowed": {
            "methods": ["GET", "HEAD"], "origins": ["${var.portal_origin}", "http://127.0.0.1:5173", "http://localhost:5173"],
            "headers": ["authorization", "range", "x-amz-date", "x-amz-content-sha256", "x-amz-security-token", "content-type"]
          },
          "expose_headers": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag", "Last-Modified"],
          "max_age_seconds": 3600
        }]
      }
    }
  }
}
