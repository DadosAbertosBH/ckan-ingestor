{
  "name": "noctcloud-lake-explorer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "types": "wrangler types --include-runtime=false",
    "check:worker": "tsc -p tsconfig.worker.json --noEmit",
    "preview": "wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "check:deploy": "pnpm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "codemirror": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/view": "^6.38.0",
    "@codemirror/autocomplete": "^6.18.0",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "apache-arrow": "17.0.0",
    "aws4fetch": "^1.0.20",
    "echarts": "^6.0.0",
    "flint-chart": "1.0.0",
    "jose": "^6.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.58.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "4.151.3"
  }
}
