{
  "rules": [
    {
      "id": "lake-explorer-read",
      "allowed": {
        "methods": ["GET", "HEAD"],
        "origins": [
          "https://noctcloud-lake-explorer.guilherme-castro.workers.dev",
          "http://127.0.0.1:5173",
          "http://localhost:5173"
        ],
        "headers": ["authorization", "range", "x-amz-date", "x-amz-content-sha256", "x-amz-security-token", "content-type"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag", "Last-Modified"],
      "maxAgeSeconds": 3600
    }
  ]
}
