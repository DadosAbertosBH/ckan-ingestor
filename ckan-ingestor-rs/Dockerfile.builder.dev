# ckan-ingestor-rs
#
# Development image used by the Rust GitLab CI job.
FROM rustlang/rust:nightly-slim-2026-07-01

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    curl \
    libssl-dev \
    libcurl4-openssl-dev \
    pkg-config \
    sccache \
    && rm -rf /var/lib/apt/lists/*
    

RUN rustup toolchain install nightly-2026-07-01 \
    --profile minimal \
    --component rustfmt \
    --component clippy \
    --component rust-analyzer \
    && rustup default nightly-2026-07-01
