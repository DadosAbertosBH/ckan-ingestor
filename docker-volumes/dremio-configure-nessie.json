   "allowCrossSourceSelection":false,
   "disableMetadataValidityCheck":false,
   "accelerationRefreshPeriod":3600000,
   "accelerationGracePeriod":10800000,
   "accelerationNeverExpire":false,
   "accelerationNeverRefresh":false,
   "type":"NESSIE",
   "accessControlList":{
      "userControls":[

      ],
      "roleControls":[

      ]
   }
